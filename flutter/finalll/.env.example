# ORCA Marine Intelligence backend environment configuration
# Copy this file to .env (same folder, next to config.py) and fill in your real values.
# Only GEMINI_API_KEY is REQUIRED. config.py hard-crashes on startup if missing.

# REQUIRED - Google Gemini API key (from Google AI Studio). Starts with "AIza...".
GEMINI_API_KEY=

# Optional - Gemini model overrides (defaults shown).
GEMINI_MODEL_L1=gemini-2.5-flash-lite
GEMINI_MODEL_L5=gemini-2.5-flash

# Optional - CORS origins (comma-separated). "*" allows any origin.
ORCA_CORS_ORIGINS=*

# Optional - geofence GeoJSON path (relative to finalll/).
ORCA_GEOFENCE_FILE=data/geofences.geojson

# Optional - public data endpoints (defaults point at public services).
INCOIS_ERDDAP_BASE=https://erddap.incois.gov.in/erddap
INCOIS_SST_DATASET=NOAA_AVHRR_AMSR_datasets
INCOIS_CHL_DATASET=IRS_chlorophyll_datasets
INCOIS_MLD_DATASET=incois_valueadded_products_datasets
PFZ_URL=https://iioe-2.incois.gov.in/MarineFisheries/TextDataHome?mfid=1&request_locale=en
